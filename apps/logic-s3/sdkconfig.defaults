# Logic node: ESP32-S3 N16R8 (WeAct).
CONFIG_IDF_TARGET="esp32s3"

# CPU 240 MHz
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Flash 16 MB
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# PSRAM 8 MB, Octal mode
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y

# Task watchdog on, checking the idle tasks of both cores (AD-3)
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y

# WiFi and lwIP tcpip tasks pinned to core 0, the outside-world core (AD-26)
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y

# Zigbee stack (AD-13): router, H2 as RCP over Spinel UART
CONFIG_ZB_ENABLED=y
CONFIG_ZB_ZCZR=y
CONFIG_ZB_RADIO_SPINEL_UART=y
